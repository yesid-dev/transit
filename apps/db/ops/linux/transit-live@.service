[Unit]
Description=Transit1 live publication for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/transit-live/r2-read.env
EnvironmentFile=/etc/transit-live/r2-write.env
WorkingDirectory=/opt/transit-live/current/apps/db
ExecStart=/opt/transit-live/current/apps/db/.venv/bin/python -m transit_ops.live.playback %i --provider-dir /opt/transit-live/current/apps/db/config/providers --source s3://transit-raw --dest s3://transit-clean
Restart=on-failure
RestartSec=10s
MemoryMax=512M
CPUWeight=25
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
